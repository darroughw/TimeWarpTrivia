NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — analytics/heatmapping no-ops (isPostHogConfigured is false)
# if these aren't set. Names are auto-generated by the Vercel PostHog
# marketplace integration ("twt_" is this project's prefix) — see
# `vercel env ls` for the exact names if you reinstall the integration.
NEXT_PUBLIC_twt_POSTHOG_PROJECT_TOKEN=phc_your-project-token
NEXT_PUBLIC_twt_POSTHOG_HOST=https://us.i.posthog.com

# Optional — error tracking/performance monitoring. Sentry.init() reads
# this directly; if it's unset the DSN is undefined and the SDK no-ops.
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.us.sentry.io/0
# Only needed for source map uploads at build time (next.config.mjs).
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-auth-token
