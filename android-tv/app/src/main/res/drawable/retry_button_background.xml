<?xml version="1.0" encoding="utf-8"?>
<!-- Marigold-filled when focused (the D-pad has landed on the only
     focusable thing on this screen), outlined marigold-on-void otherwise
     — matches the web app's own accent color so the native error screen
     doesn't look like a different app. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/marigold" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/marigold" />
            <corners android:radius="8dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
